{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpdev80/baseharbor/blob/HEAD/contracts/service/v1/exposure.schema.json",
  "title": "BaseHarbor Exposure Service Contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "exposure"},
    "contractVersion": {"const": "v1"},
    "name": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {"enum": ["http", "https"]},
        "visibility": {"enum": ["local", "private", "public"]},
        "tlsRequired": {"type": "boolean"}
      }
    }
  },
  "required": ["kind", "contractVersion", "name"]
}
