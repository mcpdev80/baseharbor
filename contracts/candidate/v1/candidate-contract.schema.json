{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpdev80/baseharbor/blob/HEAD/contracts/candidate/v1/candidate-contract.schema.json",
  "title": "BaseHarbor Candidate Contract 1",
  "description": "Exact source/image submission contract. A candidate is a fixed source revision, image digest, or native compose/quadlet unit. A submission must carry exactly one immutable identity source (source revision OR image digest, never a mutable tag alone) and never a bare secret reference. The exactly-one-source invariant is asserted in Go (candidate_contract_test.go); this schema enforces the structural identity: contract_version const, required app/target/consent bindings, a fixed source revision or a sha256-pinned image, and no unexpected keys.",
  "type": "object",
  "required": ["contract_version", "app", "target", "consent"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "baseharbor.candidate/v1"
    },
    "app": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "consent": {
      "type": "object",
      "required": ["acknowledged", "by"],
      "additionalProperties": false,
      "properties": {
        "acknowledged": { "type": "boolean" },
        "by": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "repository", "revision"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "const": "source" },
        "repository": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "image": {
      "type": "object",
      "required": ["kind", "reference", "digest"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "const": "image" },
        "reference": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "stage": { "type": "string" }
  },
  "not": {
    "required": ["source", "image"]
  }
}
