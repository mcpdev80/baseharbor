{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpdev80/baseharbor/blob/HEAD/contracts/machine/v1/terminal-input.schema.json",
  "title": "Non-replayable bounded terminal control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "sequence",
    "kind"
  ],
  "properties": {
    "contract_version": {
      "const": "v1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "input",
        "resize"
      ]
    },
    "data": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 4,
      "maxLength": 21848
    },
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input"
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "rows"
              ]
            },
            {
              "required": [
                "columns"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "resize"
          }
        }
      },
      "then": {
        "required": [
          "rows",
          "columns"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    }
  ]
}
