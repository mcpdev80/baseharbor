{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baseharbor.dev/extension/v1/extension-trust.schema.json",
  "title": "BaseHarbor Extension Artifact Trust v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "extension-descriptor.schema.json"
    },
    "trusted": {
      "type": "boolean"
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "baseharbor.extension-trust/v1"
        },
        "status": {
          "enum": [
            "verified",
            "unverifiable",
            "invalid"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "publisher": {
          "type": "string"
        },
        "signature_verified": {
          "type": "boolean"
        },
        "sbom_verified": {
          "type": "boolean"
        },
        "attestation_verified": {
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status",
        "signature_verified",
        "sbom_verified",
        "attestation_verified"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "unverifiable",
                  "invalid"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "signature_verified": {
                "const": false
              },
              "sbom_verified": {
                "const": false
              },
              "attestation_verified": {
                "const": false
              }
            },
            "not": {
              "required": [
                "publisher"
              ]
            }
          }
        }
      ]
    },
    "trust_decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "baseharbor.extension-trust/v1"
        },
        "status": {
          "enum": [
            "trusted",
            "denied"
          ]
        },
        "policy_reference": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "next": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "denied"
              }
            }
          },
          "then": {
            "required": [
              "code",
              "next"
            ]
          }
        }
      ]
    }
  },
  "required": [
    "metadata",
    "trusted",
    "verification",
    "trust_decision"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "trust_decision": {
            "properties": {
              "status": {
                "const": "trusted"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "trusted": {
            "const": true
          },
          "verification": {
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "unverifiable"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "trusted": {
            "const": false
          }
        }
      }
    }
  ]
}
