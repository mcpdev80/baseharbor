{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpdev80/baseharbor/blob/HEAD/contracts/workstationenrollment/v1/workstationenrollment.schema.json",
  "title": "baseharbor.workstation-enrollment/v1 (one-use, recipient-bound workstation registration)",
  "description": "Minimal, provider-neutral contract for a recipient-bound, short-lived, one-use workstation enrollment and the separate device identity it issues. Import grants no rights, cannot run plugins and cannot redirect credentials. Distinct from node/connector enrollment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "installation_id", "recipient", "scope", "not_before", "not_after", "import", "storage", "bootstrap"],
  "properties": {
    "version": {
      "const": "baseharbor.workstation-enrollment/v1"
    },
    "kind": {
      "enum": ["workstation-enrollment"]
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "recipient": {
      "type": "string",
      "pattern": "^spiffe://baseharbor/workstations/[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/[^?#@\\s]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "not_before": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "not_after": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_granting", "plugin_execution", "credential_redirect"],
      "properties": {
        "rights_granting": { "const": false },
        "plugin_execution": { "const": false },
        "credential_redirect": { "const": false }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "durable", "encrypted", "disaster_recovery"],
      "properties": {
        "class": { "enum": ["session-only", "protected-durable"] },
        "durable": { "type": "boolean" },
        "encrypted": { "type": "boolean" },
        "disaster_recovery": { "type": "boolean" }
      },
      "if": { "properties": { "durable": { "const": true } } },
      "then": {
        "required": ["encrypted"],
        "properties": { "encrypted": { "const": true } }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl_seconds", "certificate_ttl_seconds"],
      "properties": {
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300,
          "description": "One-use bootstrap lifetime in seconds; bounded to five minutes."
        },
        "certificate_ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400,
          "description": "Issued workstation leaf lifetime in seconds; bounded to 24 hours."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "workstation-enrollment" } } },
      "then": {
        "required": ["bootstrap"],
        "description": "A workstation-enrollment record must carry a one-use bootstrap window."
      }
    },
    {
      "if": { "properties": { "storage": { "properties": { "class": { "const": "session-only" } } } } },
      "then": {
        "properties": { "storage": { "properties": { "durable": { "const": false } } } }
      },
      "description": "A session-only record must never be durable."
    },
    {
      "if": { "properties": { "storage": { "properties": { "class": { "const": "protected-durable" } } } } },
      "then": {
        "properties": { "storage": { "properties": { "encrypted": { "const": true } }, "required": ["encrypted"] } }
      },
      "description": "A durable record must be encrypted."
    }
  ]
}
