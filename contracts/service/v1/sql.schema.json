{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baseharbor:contracts:service:v1:sql",
  "title": "BaseHarbor SQL service contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "sql"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transactions": {
          "type": "boolean"
        },
        "tls": {
          "type": "boolean"
        }
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^baha\\.[a-z0-9][a-z0-9.-]*/v[0-9]+$": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Versioned provider-neutral BaseHarbor extensions only."
    }
  }
}
