{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baseharbor:contracts:service:v1:cache",
  "title": "BaseHarbor cache service contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "cache"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "versions": {
              "type": "array",
              "items": {
                "enum": [
                  "2",
                  "3"
                ]
              },
              "uniqueItems": true,
              "minItems": 1
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^baha\\.[a-z0-9][a-z0-9.-]*/v[0-9]+$": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "description": "Versioned provider-neutral BaseHarbor extensions only."
    }
  }
}
