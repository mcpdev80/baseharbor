{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baseharbor:contracts:service:v1:identity",
  "title": "BaseHarbor identity service contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "identity"
    },
    "protocol": {
      "enum": [
        "oidc"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "description": "Versioned provider-neutral BaseHarbor policy extensions only."
    }
  }
}
