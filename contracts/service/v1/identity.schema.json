{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baseharbor.dev/service/v1/identity.schema.json",
  "title": "BaseHarbor Identity Service Contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "identity"
    },
    "contractVersion": {
      "const": "v1"
    },
    "protocol": {
      "const": "oidc"
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "required": [
    "kind",
    "contractVersion",
    "protocol"
  ]
}
