{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.baseharbor.dev/service/v1/secrets.schema.json",
  "title": "BaseHarbor Secrets Service Contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "secrets"
    },
    "contractVersion": {
      "const": "v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "requiredSecrets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotation": {
          "type": "boolean"
        },
        "renewal": {
          "type": "boolean"
        },
        "revocation": {
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "kind",
    "contractVersion",
    "name"
  ]
}
