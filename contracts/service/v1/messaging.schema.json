{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:baseharbor:contracts:service:v1:messaging",
  "title": "BaseHarbor messaging service contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "const": "messaging"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "apiDescription": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "asyncapi"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "eventEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "cloudevents"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Versioned provider-neutral BaseHarbor extensions only."
    }
  }
}
