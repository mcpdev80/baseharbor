{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "* 2-5 * * *"
  ],
  "dependencyDashboard": true,
  "rebaseWhen": "behind-base-branch",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreTests": false,
  "prConcurrentLimit": 10,
  "branchConcurrentLimit": 10,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Keep all supported dependency sources current and merge only after green checks",
      "matchManagers": [
        "gomod",
        "github-actions",
        "dockerfile",
        "docker-compose"
      ],
      "automerge": true
    },
    {
      "description": "Group routine Go dependency updates",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "groupName": "Go dependencies"
    },
    {
      "description": "Group routine GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group routine container image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "groupName": "container images"
    },
    {
      "description": "Keep major updates separate but still allow green-CI automerge",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 2-5 * * *"
    ],
    "automerge": true
  }
}
