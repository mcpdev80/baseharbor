{
  "kind": "Dashboard",
  "metadata": {
    "name": "prometheus-targets",
    "version": 0
  },
  "spec": {
    "display": {
      "name": "BaseHarbor Prometheus targets",
      "description": "Application up-signal scraped by BaseHarbor Prometheus."
    },
    "datasources": {
      "prometheus": {
        "kind": "PrometheusDatasource",
        "name": "prometheus",
        "default": true
      }
    },
    "panels": {
      "app-up": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "BaseHarbor application up"
          },
          "plugin": {
            "kind": "StatChart"
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "kind": "PrometheusTimeSeriesQuery",
                "spec": {
                  "query": "up{job=\"baseharbor-applications\",baseharbor_application=\"$application\",baseharbor_environment=\"$env\"}"
                },
                "datasource": {
                  "kind": "PrometheusDatasource",
                  "name": "prometheus"
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 6,
              "content": {
                "$ref": "#/spec/panels/app-up"
              }
            }
          ]
        }
      }
    ],
    "duration": "5m"
  }
}