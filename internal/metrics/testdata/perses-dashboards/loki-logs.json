{
  "kind": "Dashboard",
  "metadata": {
    "name": "loki-logs",
    "version": 0
  },
  "spec": {
    "display": {
      "name": "BaseHarbor Loki logs",
      "description": "Application error log stream from BaseHarbor Loki."
    },
    "datasources": {
      "loki": {
        "kind": "LokiDatasource",
        "name": "loki",
        "default": true
      }
    },
    "panels": {
      "app-errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "BaseHarbor application errors"
          },
          "plugin": {
            "kind": "LogsTable"
          },
          "queries": [
            {
              "kind": "LogQuery",
              "spec": {
                "kind": "LokiLogQuery",
                "spec": {
                  "query": "{job=\"baseharbor-applications\"} |= \"error\""
                },
                "datasource": {
                  "kind": "LokiDatasource",
                  "name": "loki"
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 10,
              "content": {
                "$ref": "#/spec/panels/app-errors"
              }
            }
          ]
        }
      }
    ]
  }
}