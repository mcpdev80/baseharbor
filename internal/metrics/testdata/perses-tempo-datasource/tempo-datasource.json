{
  "kind": "Datasource",
  "metadata": {
    "name": "baseharbor-tempo",
    "project": "baseharbor"
  },
  "spec": {
    "default": true,
    "plugin": {
      "kind": "TempoDatasource",
      "spec": {
        "proxy": {
          "kind": "HTTPProxy",
          "spec": {
            "url": "https://localhost:39901"
          }
        }
      }
    }
  }
}
